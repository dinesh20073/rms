{
  "version": 2,
  "regions": ["bom1"],
  "builds": [
    {
      "src": "ems_core/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "runtime": "python3.12",
        "includeFiles": [
          "templates/**",
          "templates/**/*",
          "ems_core/templates/**",
          "ems_core/templates/**/*",
          "apps/**",
          "apps/**/*",
          "static/**",
          "static/**/*",
          "staticfiles/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable",
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, OPTIONS, HEAD"
      },
      "dest": "ems_core/wsgi.py"
    },
    {
      "src": "/register/static/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable",
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, OPTIONS, HEAD"
      },
      "dest": "ems_core/wsgi.py"
    },
    {
      "src": "/media/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=86400",
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, OPTIONS, HEAD"
      },
      "dest": "ems_core/wsgi.py"
    },
    {
      "src": "/register/media/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=86400",
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, OPTIONS, HEAD"
      },
      "dest": "ems_core/wsgi.py"
    },
    {
      "src": "/(.*)",
      "dest": "ems_core/wsgi.py"
    }
  ]
}
