{
  "version": 2,
  "builds": [
    {
      "src": "ems_core/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.12",
        "includeFiles": [
          "templates/**",
          "templates/**/*",
          "ems_core/templates/**",
          "ems_core/templates/**/*",
          "apps/**",
          "apps/**/*",
          "static/**",
          "static/**/*"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "ems_core/wsgi.py"
    }
  ]
}
