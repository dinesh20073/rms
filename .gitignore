# ===========================================
# Registration Management System — .gitignore
# ===========================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environment
.venv/
venv/
env/
ENV/

# Database
db.sqlite3
db.sqlite3-journal

# Environment Variables
.env
.env.local
.env.production

# Static Files (collected)
staticfiles/

# Media (user uploads)
media/

# Node / Tailwind
node_modules/
package-lock.json

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Scratch / Temp
scratch/
*.log
