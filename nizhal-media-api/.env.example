# ============================================================================
# Nizhal Media API - Environment Variables
# ============================================================================

# Supabase Project URL (found in Supabase Project Settings -> API)
SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase Service Role Secret Key (found in Supabase Project Settings -> API)
# WARNING: Keep this strictly server-side. NEVER prefix with NEXT_PUBLIC_ or expose to clients.
SUPABASE_SERVICE_ROLE_KEY="eyJh...your-supabase-service-role-key"

# Deployed Frontend Origin (used for strict CORS preflight and access control)
# Example production: https://nizhalcommunity.in
# Example development: http://localhost:5173
FRONTEND_ORIGIN="https://nizhalcommunity.in"

# Admin API Secret Key (used to authorize POST /api/media additions via Bearer token)
# Generate a strong 32+ character random string (e.g., openssl rand -hex 32)
ADMIN_API_KEY="your-secure-admin-api-key-here"
